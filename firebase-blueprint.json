        "websiteUrl": { "type": "string", "maxLength": 1000 },
        "welcomeMessage": { "type": "string", "maxLength": 500 },
        "accentColor": { "type": "string", "maxLength": 20 },
        "widgetPosition": { "type": "string", "enum": ["bottom-right", "bottom-left"] },
        "widgetTheme": { "type": "string", "enum": ["light", "dark"] },
        "launcherLabel": { "type": "string", "maxLength": 60 },
        "leadCaptureEnabled": { "type": "boolean" },
        "allowedDomains": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "workspaceOwnerId", "memberUids", "createdBy", "name", "businessName", "description", "personality", "customInstructions", "voiceId", "voiceLabel", "language", "status", "createdAt", "updatedAt"]
    },
    "KnowledgeSource": {
      "title": "KnowledgeSource",
