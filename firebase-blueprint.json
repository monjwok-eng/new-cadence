{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with PII isolated to owner read/write.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "roleTitle": { "type": "string", "maxLength": 100 },
        "onboardingCompleted": { "type": "boolean" },
        "planSelected": { "type": "boolean" },
        "selectedPlan": { "type": "string", "enum": ["Starter", "Growth", "Basic", "Business", "Enterprise"] },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "onboardingData": { "type": "object", "description": "User onboarding questionnaire and starter agent preferences." },
        "enterpriseContact": { "type": "object", "description": "Enterprise contact request details submitted from pricing." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "createdAt", "updatedAt"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "Index of workspaces a user belongs to.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "workspaceName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "userId", "role", "workspaceName", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Multi-tenant organization workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "industry": { "type": "string", "maxLength": 100 },
        "timezone": { "type": "string", "maxLength": 80 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planName": { "type": "string", "enum": ["Starter", "Growth", "Basic", "Business", "Enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trialing", "past_due", "canceled"] },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "planName", "subscriptionStatus", "memberUids", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Member or pending invite within a workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceOwnerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
