  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents restricted to the profile owner."
    },
    "/users/{userId}/memberships/{workspaceId}": {
      "schema": { "$ref": "#/entities/UserMembership" },
      "description": "Per-user workspace membership index."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Organization workspaces isolated by memberUids and ownerId."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace members and role assignments."
    },
    "/workspaces/{workspaceId}/voice_agents/{agentId}": {
      "schema": { "$ref": "#/entities/VoiceAgent" },
      "description": "Voice agent configurations belonging to a workspace."
    },
    "/workspaces/{workspaceId}/knowledge_sources/{sourceId}": {
      "schema": { "$ref": "#/entities/KnowledgeSource" },
      "description": "Training sources belonging to a workspace."
    },
    "/workspaces/{workspaceId}/phone_numbers/{phoneId}": {
      "schema": { "$ref": "#/entities/PhoneNumber" },
      "description": "Demo phone numbers belonging to a workspace."
    },
    "/workspaces/{workspaceId}/call_logs/{callId}": {
      "schema": { "$ref": "#/entities/CallLog" },
      "description": "Call logs belonging to a workspace."
    },
    "/workspaces/{workspaceId}/subscriptions/{subId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Subscription tier records belonging to a workspace."
    },
    "/workspaces/{workspaceId}/api_keys/{keyId}": {
      "schema": { "$ref": "#/entities/ApiKey" },
      "description": "Masked API key metadata belonging to a workspace."
    },
    "/workspaces/{workspaceId}/voice_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/VoiceSession" },
      "description": "Voice sessions belonging to a workspace."
    },
    "/workspaces/{workspaceId}/conversation_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Voice conversation messages belonging to a workspace."
    },
