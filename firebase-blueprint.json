        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "workspaceOwnerId", "memberUids", "createdBy", "agentId", "sourceType", "sourceName", "processingStatus", "createdAt", "updatedAt"]
    },
    "PhoneNumber": {
      "title": "PhoneNumber",
