        "personality": { "type": "string", "enum": ["Friendly", "Professional", "Casual"] },
        "customInstructions": { "type": "string", "maxLength": 5000 },
        "voiceId": { "type": "string", "maxLength": 80 },
        "voiceLabel": { "type": "string", "maxLength": 120 },
        "language": { "type": "string", "maxLength": 60 },
